=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="764" y="140" width="62" height="20" as="geometry"/></mxCell><mxCell id="mobile-110" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;dashed=1;strokeColor=#1E88E5;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="mobile-63" target="mobile-70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mobile-111" value="① The nav links move behind the ☰ button. Cart stays visible because it is the main thing users need on this page." style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="290" height="90" as="geometry"/></mxCell><mxCell id="mobile-112" value="② The category tabs scroll sideways instead of wrapping onto a second row." style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="310" width="290" height="80" as="geometry"/></mxCell><mxCell id="mobile-113" value="③ The 3-column card grid becomes a 1-column list. The + buttons are 48×40 so they are easy to tap with a thumb (aim for at least 44px)." style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="420" width="290" height="110" as="geometry"/></mxCell><mxCell id="mobile-114" value="④ The desktop order &lt;aside&gt; is replaced by a bar that stays at the bottom of the screen. Tapping it opens the &quot;Your Order&quot; screen →" style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="790" width="290" height="110" as="geometry"/></mxCell><mxCell id="mobile-115" value="⑤ New screen, not a popup. It uses a normal &lt;form&gt; with a &lt;label&gt; for Special instructions (Class 5, Example 10)." style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="90" width="260" height="120" as="geometry"/></mxCell><mxCell id="mobile-116" value="⑥ Checkout sits at the bottom of the screen, within easy reach of a thumb." style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="802" width="260" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
