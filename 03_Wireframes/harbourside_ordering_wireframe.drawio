rent="1"><mxGeometry x="48" y="974" width="78" height="20" as="geometry"/></mxCell><mxCell id="desktop-117" value="① The current page (&quot;Order Online&quot;) is bold in the nav so users know where they are." style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1270" y="114" width="240" height="80" as="geometry"/></mxCell><mxCell id="desktop-118" value="② The two choices users make first (pickup/delivery and time) go at the top of the page." style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1270" y="210" width="240" height="80" as="geometry"/></mxCell><mxCell id="desktop-119" value="③ The order summary stays next to the menu, so users can see their total while they add items." style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1270" y="302" width="240" height="100" as="geometry"/></mxCell><mxCell id="desktop-120" value="④ Every menu card uses the same layout (image, name, description, price, button), so it becomes one repeated &lt;article&gt;." style="shape=note;size=14;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1270" y="416" width="240" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="mobile" name="Mobile"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mobile-1" value="Harbourside